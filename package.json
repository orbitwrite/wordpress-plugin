{
  "name": "orbitwrite",
  "version": "0.1.0",
  "private": true,
  "description": "Orbitwrite for WordPress: write a social post in WordPress and publish or schedule it with Orbitwrite.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build editor=./src/editor.tsx admin=./src/admin.tsx classic=./src/classic.tsx auto-share=./src/auto-share.tsx dashboard=./src/dashboard.tsx",
    "start": "wp-scripts start editor=./src/editor.tsx admin=./src/admin.tsx classic=./src/classic.tsx auto-share=./src/auto-share.tsx dashboard=./src/dashboard.tsx",
    "lint:js": "wp-scripts lint-js src tests --ext .js,.mjs,.ts,.tsx",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "test:js": "wp-scripts test-unit-js tests/js",
    "plugin-zip": "npm run build && wp-scripts plugin-zip",
    "env": "wp-env",
    "test:e2e": "tests/e2e/run.sh",
    "test:contract": "node --test tests/contract/contract.test.mjs",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "test": "npm run typecheck && npm run test:js && npm run test:contract",
    "openapi:check": "node scripts/sync-openapi.mjs && git diff --exit-code -- openapi/",
    "typecheck": "tsc"
  },
  "files": [
    "orbitwrite.php",
    "uninstall.php",
    "readme.txt",
    "LICENSE",
    "includes",
    "build",
    "src",
    "package.json"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/core-data": "^8.2.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/dom-ready": "^4.57.0",
    "@wordpress/editor": "^15.2.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/media-utils": "^5.57.0",
    "@wordpress/notices": "^5.57.0",
    "@wordpress/plugins": "^7.57.0",
    "@wordpress/scripts": "^30.0.0",
    "@wordpress/url": "^4.57.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
