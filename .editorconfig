# WordPress coding standards: tabs, except where the format says otherwise.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{package.json,package-lock.json,composer.json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
